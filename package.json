{
  "name": "@trimix/ai-team",
  "version": "0.30.0",
  "description": "AIチームをプロジェクトにセットアップするウィザード",
  "type": "module",
  "bin": {
    "ai-team": "./bin/setup.js"
  },
  "files": [
    "bin/",
    "templates/",
    "skills/",
    "packages/",
    "registry.json",
    "ai-team-manual-dist/"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node bin/postinstall.js",
    "sync": "node bin/sync-templates.js",
    "sync:dry": "node bin/sync-templates.js --dry",
    "apply-model-profile": "node bin/lib/apply-model-profile.js",
    "prepack": "node bin/build-dist-manual.js",
    "postpack": "node bin/build-dist-manual.js --clean",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "claude-code",
    "ai-team",
    "agents",
    "workflow"
  ],
  "author": "Trimix",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
